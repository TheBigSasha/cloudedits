<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="cloudedits"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="hdr.toys"
    UpgradeCode="E7B8C4A1-6D92-4F3B-9C1E-2A8F5D4B7E10">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Description="cloudedits — private remote photo library server for hdr.toys"
      Comments="Installed via Windows Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of cloudedits is already installed."
      AllowSameVersionUpgrades="yes" />

    <Media Id="1" Cabinet="cloudedits.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CloudeditsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CloudeditsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://hdr.toys" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="cloudedits">
          <Component Id="MainExecutable" Guid="9A5F1D42-7C83-4E21-B104-6F3E8A2C5D91" Win64="yes">
            <File Id="CloudeditsExe" Source="$(var.BinaryPath)" KeyPath="yes" />
            <Environment
              Id="CloudeditsPath"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Permanent="no"
              Part="last"
              Action="set"
              System="yes" />
          </Component>

          <Component Id="LicenseComponent" Guid="3B1E7C94-2D60-4A85-9E12-4C7A6F8B3D20" Win64="yes">
            <File Id="LicenseFile" Source="$(var.LicensePath)" KeyPath="yes" />
          </Component>

          <Component Id="ReadmeComponent" Guid="6D4A9E18-5F72-4B39-8C26-1E9B4D7A5F63" Win64="yes">
            <File Id="ReadmeFile" Source="$(var.ReadmePath)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="cloudedits">
          <Component Id="StartMenuShortcut" Guid="4C8E2F61-9A15-4D73-B508-7A2C9E4F1B38">
            <Shortcut
              Id="CloudeditsSetupShortcut"
              Name="cloudedits Setup"
              Description="Launch cloudedits browser setup wizard"
              Target="[INSTALLFOLDER]cloudedits.exe"
              Arguments="gui"
              WorkingDirectory="INSTALLFOLDER"
              Icon="CloudeditsIcon.ico" />
            <RemoveFolder Id="CleanStartMenuFolder" On="uninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\cloudedits"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="cloudedits" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="ReadmeComponent" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
