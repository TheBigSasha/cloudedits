<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="cloudedits"
    Manufacturer="hdr.toys"
    Version="$(var.Version)"
    UpgradeCode="E7B8C4A1-6D92-4F3B-9C1E-2A8F5D4B7E10"
    Scope="perMachine"
    InstallerVersion="500">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of cloudedits is already installed."
      AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CloudeditsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CloudeditsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://hdr.toys" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtfPath)" />
    <ui:WixUI Id="WixUI_Minimal" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch cloudedits Setup" />
    <Property Id="WixShellExecTarget" Value="[#CloudeditsSetupExe]" />
    <CustomAction
      Id="LaunchApplication"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixShellExec"
      Impersonate="yes" />

    <UI>
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchApplication"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="cloudedits">
        <Component Id="MainExecutable" Guid="9A5F1D42-7C83-4E21-B104-6F3E8A2C5D91">
          <File Id="CloudeditsExe" Source="$(var.BinaryPath)" KeyPath="yes" />
          <Environment
            Id="CloudeditsPath"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
        </Component>

        <Component Id="SetupLauncherExecutable" Guid="B4D2E8A1-3F90-4C62-8A17-5E9C2B4D6F03">
          <File Id="CloudeditsSetupExe" Source="$(var.SetupBinaryPath)" KeyPath="yes" />
        </Component>

        <Component Id="LicenseComponent" Guid="3B1E7C94-2D60-4A85-9E12-4C7A6F8B3D20">
          <File Id="LicenseFile" Source="$(var.LicensePath)" KeyPath="yes" />
        </Component>

        <Component Id="ReadmeComponent" Guid="6D4A9E18-5F72-4B39-8C26-1E9B4D7A5F63">
          <File Id="ReadmeFile" Source="$(var.ReadmePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="cloudedits">
        <Component Id="StartMenuShortcut" Guid="4C8E2F61-9A15-4D73-B508-7A2C9E4F1B38">
          <Shortcut
            Id="CloudeditsSetupShortcut"
            Name="cloudedits Setup"
            Description="Launch cloudedits Setup"
            Target="[INSTALLFOLDER]cloudedits-setup.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="CloudeditsIcon.ico" />
          <RemoveFolder Id="CleanStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\cloudedits"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="8E2A5C71-4B19-4F83-9D62-1C3E7A9B5D40">
        <Shortcut
          Id="CloudeditsDesktopShortcut"
          Name="cloudedits Setup"
          Description="Launch cloudedits Setup"
          Target="[INSTALLFOLDER]cloudedits-setup.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="CloudeditsIcon.ico" />
        <RegistryValue
          Root="HKCU"
          Key="Software\cloudedits"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="cloudedits" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="SetupLauncherExecutable" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="ReadmeComponent" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
